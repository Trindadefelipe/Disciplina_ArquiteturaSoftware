flowchart LR
    Company(["Empresa<br>Vende produtos por telefone ou encontros presenciais"])
    Sellers(["Vendedores<br>Precisam do sistema para registrar pedidos"])
    Administrators(["Administradores<br>Cadastra e remove produtos para venda"])
    StockTeam(["Time de estoque<br>Controla a quantidade de produto disponível no estoque"])
    
    System["Sistema da empresa"]
    Products(["Produtos vendidos pela empresa"])

    Company -->|Vende produtos| Products
    Sellers -->|Vende e negocia os produtos disponíveis| Products
