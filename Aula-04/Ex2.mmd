flowchart TD
    Customer(["Usuário / Cliente"])
    
    subgraph Users ["Tipos de Usuários Internos"]
        direction LR
        Admin["Administrador"]
        Stock["Time de Estoque"]
        Seller["Vendedor"]
    end

    subgraph System ["Sistema da empresa"]
        direction TB
        %% Alterei as chaves aqui para retângulos e cilindro:
        FrontEnd["Aplicação Web (Front-end)<br>Onde vendedores e admins navegam"]
        API["API (Back-end)<br>Api que gerencia requisições"]
        DataBase[("Banco de Dados<br>Onde os dados são armazenados e gerenciados")]
    end

    Customer -->|Negocia os produtos disponíveis| Seller
    
    Admin -->|Cadastra e remove produtos para venda| FrontEnd
    Stock -->|Registra entradas e saídas de estoque| FrontEnd
    Seller -->|Acessa para registrar os pedidos| FrontEnd
    FrontEnd -->|Emite as requisições| API
    API -->|Lê e insere/devolve os dados| DataBase

    %% Estilo
    style System fill:#f4f4f4,stroke:#333,stroke-width:2px,color:#000
    style DataBase fill:#1168bd,stroke:#0b4884,color:#fff
    style API fill:#438dd5,stroke:#0b4884,color:#fff
    style FrontEnd fill:#438dd5,stroke:#0b4884,color:#fff