flowchart TD
    Customer(["Usuário / Cliente"])
    
    subgraph Users ["Tipos de Usuários Internos"]
        direction LR
        Admin["Administrador"]
        Stock["Estoque"]
        Seller["Vendedor"]
    end

    subgraph System ["Sistema da empresa"]
        direction TB
        FrontEnd["Front-end<br>(Camada de Apresentação)"]
        API["API / Back-end<br>(Camada de Domínio)"]
        DataBase[("Banco de Dados<br>(Camada de Dados)")]
    end

    Customer -->|Negocia produtos| Seller
    
    Admin -->|Gerencia produtos| FrontEnd
    Stock -->|Controla estoque| FrontEnd
    Seller -->|Registra pedidos| FrontEnd
    
    FrontEnd -->|Requisições| API
    API -->|Lê e Grava| DataBase

    %% Estilização
    style System fill:#f4f4f4,stroke:#333,stroke-width:2px,color:#000
    style DataBase fill:#1168bd,stroke:#0b4884,color:#fff
    style API fill:#438dd5,stroke:#0b4884,color:#fff
    style FrontEnd fill:#438dd5,stroke:#0b4884,color:#fff